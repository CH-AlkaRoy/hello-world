<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Benefit Search Test Suite" parallel="methods" thread-count="3" verbose="1">
    
    <parameter name="browser" value="chrome"/>
    
    <listeners>
        <!-- Add custom listeners here if needed -->
        <!-- <listener class-name="com.collectivehealth.benefitSearch.listeners.TestListener"/> -->
    </listeners>
    
    <!-- Smoke Test Suite -->
    <test name="Smoke Tests" preserve-order="true">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.collectivehealth.benefitSearch.testplan.BenefitSearchTestSuite"/>
        </classes>
    </test>
    
    <!-- Regression Test Suite -->
    <test name="Regression Tests" preserve-order="true" enabled="false">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.collectivehealth.benefitSearch.testplan.BenefitSearchTestSuite"/>
        </classes>
    </test>
    
    <!-- Full Test Suite -->
    <test name="Full Test Suite" preserve-order="true" enabled="false">
        <classes>
            <class name="com.collectivehealth.benefitSearch.testplan.BenefitSearchTestSuite"/>
        </classes>
    </test>
    
</suite>
